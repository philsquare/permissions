{
  "name": "philsquare/permissions",
  "description": "Laravel policy scaffolding and permission management built on Spatie Permissions",
  "keywords": [
    "laravel",
    "permissions",
    "roles",
    "authorization",
    "policy",
    "spatie"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Phil Mareu",
      "email": "phil@philsquare.com",
      "homepage": "https://philsquare.com"
    }
  ],
  "homepage": "https://github.com/philsquare/permissions",
  "support": {
    "issues": "https://github.com/philsquare/permissions/issues",
    "source": "https://github.com/philsquare/permissions"
  },
  "require": {
    "php": "^8.4",
    "spatie/laravel-permission": "^8.3",
    "spatie/laravel-package-tools": "^1.92"
  },
  "autoload": {
    "psr-4": {
      "Philsquare\\Permissions\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Philsquare\\Permissions\\PermissionsServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
