{
  "name": "philsquare/permissions",
  "description": "Laravel policy scaffolding and permission management built on Spatie Permissions",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Phil Mareu",
      "email": "phil@philsquare.com",
      "homepage": "https://philsquare.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "spatie/laravel-permission": "^6.21",
    "spatie/laravel-package-tools": "^1.92"
  },
  "autoload": {
    "psr-4": {
      "Philsquare\\Permissions\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Philsquare\\Permissions\\PermissionsServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
